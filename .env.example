# Neon Serverless PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk (autenticación, sesiones y RBAC)
# Obtener en Clerk Dashboard -> API Keys (modo dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/registro"

# Mercado Pago (Checkout Pro - Sandbox)
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-..."
# Clave secreta del webhook: debe pertenecer a la MISMA aplicación que el access
# token (Tus integraciones -> esa app -> Webhooks -> Clave secreta). Sin espacios
# ni comillas internas. Sin ella el webhook no procesa notificaciones.
MERCADOPAGO_WEBHOOK_SECRET="..."

# Opcionales de diagnóstico del webhook
# MERCADOPAGO_WEBHOOK_VERBOSE_LOG="true"      # loguea URL, headers y body de cada notificación
# MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS="300" # rechaza firmas con ts más antiguo que N segundos

# SOLO PARA DEMOS: omite la validación de firma del webhook y acepta cualquier
# notificación con el payload esperado. Nunca habilitar en producción.
# SKIP_WEBHOOK_VALIDATION="true"